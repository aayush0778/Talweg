# ==================================================
# SlopeGuard AI — Environment Configuration
# ==================================================
# Copy this file to .env and fill in values.
# NEVER commit .env to git.

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/slopeguard_dev

# Server
PORT=3001
NODE_ENV=development

# ML Service (Phase 5 — FastAPI surrogate model sidecar)
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=1000

# Risk Engine Mode: "deterministic" (default safety engine) or "ml" (for the live ML sidecar / failover demo)
# In "ml" mode, if the ML service is down or times out, the backend silently falls back to deterministic.
RISK_ENGINE_MODE=deterministic

# Copilot LLM (optional — deterministic fallback works without these)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
COPILOT_TIMEOUT_MS=8000
